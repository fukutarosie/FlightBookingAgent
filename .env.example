# XRPL Testnet websocket endpoint (default is fine for most cases)
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# Provider ports
PORT_A=4001
PORT_B=4002

# Wallet seeds — leave unset on first run and each service will generate +
# fund a new Testnet wallet automatically, printing the seed to save here.
COMPANY_WALLET_SEED=
PROVIDER_A_WALLET_SEED=
PROVIDER_B_WALLET_SEED=

# Only needed if running scripts/test-real-payment.mjs against a
# non-default provider location
PROVIDER_A_URL=http://localhost:4001

# Optional: enables genuine LLM reasoning for offer selection. Without this,
# the agent falls back to the deterministic scoring formula's top pick —
# nothing breaks, it just isn't AI-driven. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: notifies a Telegram chat when a booking is held for approval or
# rejected. Create a bot via @BotFather to get a token, then message it once
# and use https://api.telegram.org/bot<token>/getUpdates to find your chat id.
# Leave blank to skip notifications entirely (no error, just a no-op).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Policy thresholds (see agent/config.mjs) — testnet-scaled defaults.
AUTO_APPROVE_LIMIT=1.0
HARD_CAP=2.0
